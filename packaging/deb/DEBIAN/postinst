#!/bin/sh
set -e

# Create caddy user and group if missing
if ! getent group caddy >/dev/null 2>&1; then
    groupadd --system caddy
fi

if ! getent passwd caddy >/dev/null 2>&1; then
    useradd --system \
        --gid caddy \
        --create-home \
        --home-dir /var/lib/caddy \
        --shell /usr/sbin/nologin \
        --comment "Caddy web server" \
        caddy
fi

# Directory setup and permissions
mkdir -p /var/log/caddy /var/lib/caddy /etc/caddy /etc/wifi-enrollment /etc/systemd/system/caddy.service.d
chown -R caddy:caddy /var/log/caddy /var/lib/caddy /etc/caddy

# Set up .env configuration
if [ ! -f /etc/wifi-enrollment/.env ]; then
    echo "Creating default /etc/wifi-enrollment/.env configuration..."
    cp /opt/wifi-enrollment/.env.example /etc/wifi-enrollment/.env
    chmod 600 /etc/wifi-enrollment/.env
fi

# Link .env to service directory
ln -sf /etc/wifi-enrollment/.env /opt/wifi-enrollment/.env

# Install uv package manager if missing
if ! command -v uv >/dev/null 2>&1 && [ ! -x /usr/local/bin/uv ]; then
    echo "Installing uv package manager..."
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/usr/local/bin" sh
fi

UV_BIN=$(command -v uv || echo "/usr/local/bin/uv")

# Sync Python virtual environment in /opt/wifi-enrollment
echo "Syncing Python dependencies for wifi-enrollment..."
cd /opt/wifi-enrollment
touch README.md
"$UV_BIN" sync --frozen --no-dev || "$UV_BIN" sync --no-dev

# Reload systemd
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload
    echo "Enabling systemd services for spoutin-pki..."
    systemctl enable caddy.service wifi-enrollment.service spoutin-pki.target || true

    # Automatically restart services on package upgrade so they stay active
    if systemctl is-enabled --quiet caddy 2>/dev/null; then
        echo "Restarting caddy service..."
        systemctl restart caddy || true
    fi
    if systemctl is-enabled --quiet wifi-enrollment 2>/dev/null; then
        echo "Restarting wifi-enrollment service..."
        systemctl restart wifi-enrollment || true
    fi

    echo "wifi-enrollment and caddy installed successfully."
    echo ""
    echo "Next steps:"
    echo "  1. Edit /etc/wifi-enrollment/.env with your Slack & OPNsense credentials."
    echo "  2. Edit /etc/systemd/system/caddy.service.d/override.conf with CLOUDFLARE_API_TOKEN."
    echo "  3. Start the entire PKI stack with a single command:"
    echo "       systemctl start spoutin-pki.target"
    echo "     (or individually: systemctl start wifi-enrollment caddy)"
fi

exit 0
