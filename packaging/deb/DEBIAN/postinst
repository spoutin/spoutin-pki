#!/bin/sh
set -e

# Directory setup and permissions
mkdir -p /etc/pki /opt/pki/data

# 1. Set up /etc/pki/config.env configuration with auto-migration from legacy wifi-enrollment
if [ ! -f /etc/pki/config.env ]; then
    if [ -f /etc/wifi-enrollment/config.env ]; then
        echo "Migrating existing /etc/wifi-enrollment/config.env to /etc/pki/config.env..."
        cp /etc/wifi-enrollment/config.env /etc/pki/config.env
        chmod 600 /etc/pki/config.env
    elif [ -f /etc/wifi-enrollment/.env ]; then
        echo "Migrating existing /etc/wifi-enrollment/.env to /etc/pki/config.env..."
        cp /etc/wifi-enrollment/.env /etc/pki/config.env
        chmod 600 /etc/pki/config.env
    else
        echo "Creating default /etc/pki/config.env configuration..."
        if [ -f /opt/pki/config.env.example ]; then
            cp /opt/pki/config.env.example /etc/pki/config.env
        else
            cp /opt/pki/.env.example /etc/pki/config.env
        fi
        chmod 600 /etc/pki/config.env
    fi
fi

# 2. Migrate existing SQLite database if present
if [ ! -f /opt/pki/data/inventory.db ]; then
    if [ -f /opt/wifi-enrollment/data/inventory.db ]; then
        echo "Migrating SQLite inventory database from /opt/wifi-enrollment to /opt/pki..."
        cp -a /opt/wifi-enrollment/data/inventory.db /opt/pki/data/inventory.db
    fi
fi

# Link config.env to service directory
ln -sf /etc/pki/config.env /opt/pki/config.env
ln -sf /etc/pki/config.env /opt/pki/.env

# Install uv package manager if missing
if ! command -v uv >/dev/null 2>&1 && [ ! -x /usr/local/bin/uv ]; then
    echo "Installing uv package manager..."
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/usr/local/bin" sh
fi

UV_BIN=$(command -v uv || echo "/usr/local/bin/uv")

# Sync Python virtual environment in /opt/pki
echo "Syncing Python dependencies for pki in /opt/pki..."
cd /opt/pki
touch README.md
"$UV_BIN" sync --frozen --no-dev || "$UV_BIN" sync --no-dev

# Reload systemd and enable pki.service
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload
    echo "Enabling and starting pki.service..."
    systemctl enable pki.service || true
    systemctl restart pki.service || systemctl start pki.service || true

    echo "PKI service installed successfully."
    echo ""
    echo "Service Status:"
    echo "  systemctl status pki"
fi

exit 0
