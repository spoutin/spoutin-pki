[Unit]
Description=Spoutin Wi-Fi EAP-TLS Enrollment Service
Documentation=https://github.com/spoutin/spoutin-pki
After=network.target network-online.target step-ca.service
Wants=network-online.target step-ca.service
Before=caddy.service

ConditionPathExists=/opt/wifi-enrollment
ConditionPathExists=/etc/wifi-enrollment/.env

[Service]
Type=simple
User=root
WorkingDirectory=/opt/wifi-enrollment
EnvironmentFile=/etc/wifi-enrollment/.env
ExecStart=/opt/wifi-enrollment/.venv/bin/uvicorn services.wifi_enrollment.server:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5s

# Process security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/wifi-enrollment
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
