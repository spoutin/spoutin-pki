[Unit]
Description=Spoutin Wi-Fi EAP-TLS Enrollment Service
After=network.target step-ca.service
Wants=step-ca.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/spoutin-pki
EnvironmentFile=/opt/spoutin-pki/.env
ExecStart=/opt/spoutin-pki/.venv/bin/uvicorn services.wifi_enrollment.server:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Standard logging to journald
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
