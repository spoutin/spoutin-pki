[Unit]
Description=Spoutin Wi-Fi EAP-TLS Enrollment Service
Documentation=https://github.com/spoutin/spoutin-pki
After=network.target network-online.target
Wants=network-online.target

ConditionPathExists=/opt/spoutin-pki
ConditionPathExists=|/etc/wifi-enrollment/config.env
ConditionPathExists=|/etc/wifi-enrollment/.env

[Service]
Type=simple
User=root
WorkingDirectory=/opt/spoutin-pki
Environment="CONFIG_PATH=/etc/wifi-enrollment/config.env"
EnvironmentFile=-/etc/wifi-enrollment/.env
EnvironmentFile=-/etc/wifi-enrollment/config.env
ExecStart=/opt/spoutin-pki/.venv/bin/uvicorn services.wifi_enrollment.server:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
