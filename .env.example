# ==============================================================================
# Spoutin Wi-Fi Enrollment Portal Configuration
# Path: /etc/wifi-enrollment/config.env (or .env)
# ==============================================================================

# --- Service Configuration ---
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8000
NETWORK_DOMAIN=int.spoutin.org
RADIUS_SERVER_DOMAIN=radius.int.spoutin.org
LOG_LEVEL=INFO

# --- Rate Limiting & TTL ---
RATE_LIMIT_REQUESTS=3
RATE_LIMIT_WINDOW_SECONDS=600
REQUEST_TTL_SECONDS=900
MAX_PENDING_REQUESTS=10

# --- CA Provider ("openbao", "infisical", or "step-ca") ---
CA_PROVIDER=openbao

# --- OpenBao PKI API (AppRole Service Account or Static Token) ---
OPENBAO_URL=http://127.0.0.1:8200
OPENBAO_ROLE_ID=your_openbao_role_id_here
OPENBAO_SECRET_ID=your_openbao_secret_id_here
OPENBAO_PKI_MOUNT=pki
OPENBAO_ROLE=wifi-client
OPENBAO_VERIFY_SSL=true

# --- Infisical PKI API (Alternative: Self-Hosted or Cloud) ---
INFISICAL_URL=https://secrets.int.spoutin.org
INFISICAL_CLIENT_ID=your_machine_identity_client_id
INFISICAL_CLIENT_SECRET=your_machine_identity_client_secret
INFISICAL_PROJECT_ID=your_project_id
INFISICAL_CA_ID=your_issuing_ca_id
INFISICAL_VERIFY_SSL=true

# --- step-ca REST API (legacy/fallback if CA_PROVIDER=step-ca) ---
STEP_CA_URL=https://127.0.0.1:9000
STEP_CA_PROVISIONER_NAME=admin@int.spoutin.org
# Path to the exported or provisioner JWK private key (or JSON string):
STEP_CA_PROVISIONER_KEY_PATH=/etc/step-ca/secrets/provisioner_key.json
STEP_CA_PROVISIONER_PASSWORD=
STEP_ROOT_CERT_PATH=/etc/step-ca/certs/root_ca.crt
STEP_INTERMEDIATE_CERT_PATH=/etc/step-ca/certs/intermediate_ca.crt
CERT_VALIDITY_HOURS=52560h

# --- OPNsense FreeRADIUS API ---
OPNSENSE_URL=https://opnsense.int.spoutin.org
OPNSENSE_API_KEY=your_opnsense_api_key_here
OPNSENSE_API_SECRET=your_opnsense_api_secret_here
OPNSENSE_VERIFY_SSL=false
OPNSENSE_INTERMEDIATE_CA_REFID=

# --- Slack App (Socket Mode & OAuth) ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_CHANNEL_ID=C0XXXXXXXXX
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
ADMIN_SLACK_EMAILS=admin@example.com
SESSION_SECRET_KEY=change-this-to-a-secure-random-secret-key
DATABASE_PATH=/opt/pki/data/inventory.db
